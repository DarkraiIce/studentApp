# Non-secret defaults for the Base44 sandbox (see docker-compose.base44.yml).
#
# Local infrastructure credentials live in the compose file; APP_KEY and any real
# external credentials are delivered by the platform to /run/base44/app.env, which is
# listed AFTER this file in env_file and therefore always wins.
APP_NAME=camino
APP_ENV=local
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
MAIL_MAILER=log
